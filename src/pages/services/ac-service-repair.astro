---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'A/C Repair & Service',
  description: 'Car A/C not blowing cold? Expert diagnosis and repair in Sylvan Lake. R-134a and R-1234yf service. Leak detection, compressor repair, full system service. Call (403) 887-0440.',
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Automotive A/C Service & Repair",
  "description": "Automotive air conditioning diagnosis and repair in Sylvan Lake, Alberta",
  "provider": {
    "@type": "AutoRepair",
    "name": "Sylvan Lake AUTOPRO",
    "telephone": "+1-403-887-0440",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1A Industrial Dr",
      "addressLocality": "Sylvan Lake",
      "addressRegion": "AB",
      "postalCode": "T4S 1P4",
      "addressCountry": "CA"
    }
  },
  "areaServed": ["Sylvan Lake", "Benalto", "Eckville", "Condor", "Leslieville", "Bentley", "Blackfalds", "Lacombe", "Gull Lake", "Red Deer", "Red Deer County", "Penhold", "Innisfail", "Norglenwold", "Birchcliff", "Jarvis Bay", "Half Moon Bay", "Sunbreaker Cove"]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why is my car A/C blowing hot air?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The most common causes are low refrigerant from a slow leak, a failed compressor, a blocked condenser, or an electrical issue like a bad clutch relay. It can also be something as simple as a clogged cabin air filter killing airflow. Diagnosis is the only way to know for sure—the cause changes the repair completely."
      }
    },
    {
      "@type": "Question",
      "name": "What type of refrigerant does my car use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Vehicles built roughly before 2015 typically use R-134a. Vehicles from 2015 onward increasingly use R-1234yf, which requires different equipment and costs more to service. There's a label under your hood near the radiator support—or just bring it in and we'll identify it before we touch anything."
      }
    },
    {
      "@type": "Question",
      "name": "How do I know if it's the compressor or just low refrigerant?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Both can cause warm air. The difference shows up in a pressure test. If pressures are normal but the compressor clutch isn't engaging, it's electrical or mechanical. If pressures are low, there's a leak somewhere. We don't guess—we test first."
      }
    },
    {
      "@type": "Question",
      "name": "How long does an A/C repair take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It varies widely. A leak repair and recharge is often same-day. Compressor replacement is typically a full day. Evaporator replacement requires dash removal and runs multiple days. We'll give you a realistic timeline before you commit."
      }
    },
    {
      "@type": "Question",
      "name": "My A/C smells musty. What causes that?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mould and bacteria growing on the evaporator. When you shut off the A/C, moisture on the cold evaporator becomes a breeding ground. An evaporator cleaning and antibacterial treatment fixes it in most cases. A tip to prevent it: switch the A/C off a minute before you arrive and let the fan run on heat to dry the evaporator."
      }
    },
    {
      "@type": "Question",
      "name": "Why is A/C repair more expensive than it used to be?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Modern R-1234yf refrigerant costs significantly more than older R-134a. A system that takes a full charge might run $150+ in refrigerant alone, before any parts or labour. Proper leak detection and repair before recharging is more important than ever."
      }
    },
    {
      "@type": "Question",
      "name": "How often do I actually need A/C service?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We don't push annual service. If your A/C is cooling well, have it inspected every couple of years or whenever you notice reduced performance. Your regular maintenance visits include a visual check of A/C components. The main thing is don't ignore gradual refrigerant loss—it's slow enough that you often don't notice until it stops working on the hottest day of the year."
      }
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sylvanlakeautopro.com/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://sylvanlakeautopro.com/services/" },
    { "@type": "ListItem", "position": 3, "name": "A/C Service & Repair" }
  ]
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <!-- Hero Section -->
  <Hero2
    tagline="Climate Control"
    title="Automotive A/C Service & Repair"
    subtitle="Proper Diagnosis. Quality Repairs. All Refrigerant Types."
    actions={[
      { variant: 'primary', text: 'Book A/C Service', href: 'https://sylvanlakeautopro.autotext.me/Admin/kioskv2/index.php?id=WTNHaFJhb1g1dk9YV3g1YmpkUEx3QT09&kiosk=1', target: '_blank' },
      { variant: 'secondary', text: 'Call (403) 887-0440', href: 'tel:+14038870440', class: 'md:hidden' },
      { variant: 'secondary', text: 'Get Directions', href: 'https://www.google.com/maps/dir/?api=1&destination=NAPA+AUTOPRO+-+Sylvan+Lake+AUTOPRO+Inc&destination_place_id=ChIJM5AeqqSydVMRS6-I0MZs35U', class: 'hidden md:inline-flex' },
    ]}
  />

  <!-- Introduction Section -->
  <Content
    title="Car A/C Not Blowing Cold in Sylvan Lake?"
    content="We diagnose and repair automotive air conditioning systems right here in Sylvan Lake. We service all refrigerant types—<strong>R-134a and the newer R-1234yf</strong> systems that require specialized equipment many shops in the area don't have.<br/><br/><strong>Not sure what's wrong? A diagnostic is the right first step—not a recharge.</strong> Throwing refrigerant at an undiagnosed problem is the most common and most expensive mistake we see.<br/><br/>A/C problems range from simple (low refrigerant from a slow leak) to complex (compressor failure, blend door actuators, electronic control issues). We figure out what's actually wrong before recommending repairs.<br/><br/>Blowing hot air right now? We wrote the straight-answer guide: <a href='/blog/why-is-my-car-ac-blowing-hot-air' class='text-primary font-medium underline'>Why Is My Car A/C Blowing Hot Air?</a>"
  />

  <!-- Problem Categories Section -->
  <Features2
    title="Why Is My A/C Not Cooling?"
    subtitle="Common causes of air conditioning problems"
    columns={3}
    items={[
      {
        title: 'Refrigerant Issues',
        description: 'Low refrigerant from leaks, contaminated refrigerant from DIY kits, or wrong refrigerant type.',
        icon: 'tabler:gas-station',
      },
      {
        title: 'Mechanical Failures',
        description: 'Compressor failure, condenser damage from road debris, evaporator leak, expansion valve problems.',
        icon: 'tabler:settings',
      },
      {
        title: 'Electrical & Controls',
        description: 'Compressor clutch failure, pressure switch malfunction, blend door actuator, sensor failures.',
        icon: 'tabler:plug',
      },
    ]}
  />

  <!-- Alberta Challenges Section -->
  <Content
    isReversed={true}
    title="Why Alberta Is Hard on A/C Systems"
    content="You'd think A/C problems would be a hot-climate issue. Alberta actually creates unique challenges:<br/><br/><strong>Extended Dormancy:</strong> We barely use A/C for eight months of the year. Seals dry out when the system sits idle. When you finally turn it on in June, that's when problems appear.<br/><br/><strong>Temperature Extremes:</strong> Going from -30°C to +30°C stresses every seal, hose, and fitting. Expansion and contraction eventually cause leaks.<br/><br/><strong>Road Debris:</strong> Alberta roads throw rocks. The condenser sits right behind the grille, taking direct hits.<br/><br/><strong>Expensive Refrigerant:</strong> Modern R-1234yf costs significantly more than older R-134a. Finding and fixing leaks properly is more important than ever."
    items={[
      { title: 'Pro Tip', description: 'Run your A/C for 10 minutes monthly, even in winter. It keeps seals lubricated and catches problems before summer.' },
    ]}
  />

  <!-- Our Services Section -->
  <Features2
    title="Our A/C Services"
    subtitle="Complete air conditioning diagnosis and repair"
    columns={2}
    items={[
      {
        title: 'Diagnosis & Leak Detection',
        description: 'Pressure testing, electronic leak detection, UV dye injection. We find the actual problem before repairs begin.',
        icon: 'tabler:search',
      },
      {
        title: 'System Recharge',
        description: 'After verifying no leaks exist, we recharge with the correct refrigerant type and exact amount specified.',
        icon: 'tabler:reload',
      },
      {
        title: 'Compressor Replacement',
        description: 'Full service including system flush, receiver/drier replacement, and proper oil charge. Done right to prevent repeat failures.',
        icon: 'tabler:engine',
      },
      {
        title: 'Condenser Replacement',
        description: 'Road debris damage repair. We check for internal restrictions and external blockage.',
        icon: 'tabler:layout-grid',
      },
      {
        title: 'Evaporator Service',
        description: 'Inside the dash—same labor as heater core. We recommend doing both if accessing the HVAC housing.',
        icon: 'tabler:air-conditioning',
      },
      {
        title: 'Electrical Diagnostics',
        description: 'Scan tool communication with the HVAC module to diagnose sensor, actuator, and control problems. A lot of A/C issues are electrical—they won\'t get fixed by recharging.',
        icon: 'tabler:cpu',
      },
      {
        title: 'Cabin Air Filter Replacement',
        description: 'A clogged cabin air filter cuts airflow and makes the whole system work harder. Often overlooked, easy to fix.',
        icon: 'tabler:filter',
      },
    ]}
  />

  <!-- Refrigerant Types Section -->
  <Content
    title="Refrigerant Types We Service"
    content="<strong>R-12 (Pre-1994):</strong> No longer available. We offer retrofit to R-134a.<br/><br/><strong>R-134a (1994-2015):</strong> Most common type, reasonable cost.<br/><br/><strong>R-1234yf (2015+):</strong> Required on newer vehicles, significantly more expensive.<br/><br/>We've invested in equipment to service all refrigerant types, including R-1234yf systems that many shops can't handle."
  />

  <!-- DIY Warning Section -->
  <Content
    isReversed={true}
    title="Why DIY Recharge Kits Are a Bad Idea"
    content="We strongly advise against DIY A/C recharge kits. Here's why:<br/><br/>• <strong>Overcharge the system</strong> — Damages components<br/>• <strong>Contaminate the refrigerant</strong> — We can't service it with our equipment<br/>• <strong>Include 'stop leak' chemicals</strong> — Clogs components<br/>• <strong>Don't fix the actual leak</strong> — Just delays the real repair<br/><br/>What seems like a $40 money-saver often creates hundreds in additional expense, or leaves us unable to service your vehicle until the contaminated refrigerant is evacuated with special equipment."
  />

  <!-- Spring Check Section -->
  <Content
    title="Spring A/C Check: Beat the Summer Rush"
    content="Every year we see the same pattern: first hot week in June, phones ring off the hook with A/C problems.<br/><br/><strong>Get your A/C checked in spring:</strong><br/>• No waiting—we can get you in quickly<br/>• Find problems before you're sweating in traffic<br/>• Time to order parts if needed<br/>• Avoid being stuck in a queue when everyone else discovers their A/C is dead<br/><br/>A 15-minute check in May beats a week without A/C in July."
  />

  <!-- FAQ Section -->
  <FAQs
    title="Frequently Asked Questions"
    subtitle="Common questions about automotive A/C service"
    columns={1}
    items={[
      {
        title: "Why is my car A/C blowing hot air?",
        description: "The most common causes are low refrigerant from a slow leak, a failed compressor, a blocked condenser, or an electrical issue like a bad clutch relay. It can also be something as simple as a clogged cabin air filter killing airflow. Diagnosis is the only way to know for sure—the cause changes the repair completely. (We go deeper in our guide: Why Is My Car A/C Blowing Hot Air?)",
      },
      {
        title: "What type of refrigerant does my car use?",
        description: "Vehicles built roughly before 2015 typically use R-134a. Vehicles from 2015 onward increasingly use R-1234yf, which requires different equipment and costs more to service. There's a label under your hood near the radiator support—or just bring it in and we'll identify it before we touch anything.",
      },
      {
        title: "How do I know if it's the compressor or just low refrigerant?",
        description: "Both can cause warm air. The difference shows up in a pressure test. If pressures are normal but the compressor clutch isn't engaging, it's electrical or mechanical. If pressures are low, there's a leak somewhere. We don't guess—we test first.",
      },
      {
        title: "How long does an A/C repair take?",
        description: "It varies widely. A leak repair and recharge is often same-day. Compressor replacement is typically a full day. Evaporator replacement requires dash removal and runs multiple days. We'll give you a realistic timeline before you commit.",
      },
      {
        title: "My A/C smells musty. What causes that?",
        description: "Mould and bacteria growing on the evaporator. When you shut off the A/C, moisture on the cold evaporator becomes a breeding ground. An evaporator cleaning and antibacterial treatment fixes it in most cases. A tip to prevent it: switch the A/C off a minute before you arrive and let the fan run on heat to dry the evaporator.",
      },
      {
        title: "Why is A/C repair more expensive than it used to be?",
        description: "Modern R-1234yf refrigerant costs significantly more than older R-134a. A system that takes a full charge might run $150+ in refrigerant alone, before any parts or labour. Proper leak detection and repair before recharging is more important than ever.",
      },
      {
        title: "How often do I actually need A/C service?",
        description: "We don't push annual service. If your A/C is cooling well, have it inspected every couple of years or whenever you notice reduced performance. Your regular maintenance visits include a visual check of A/C components. The main thing is don't ignore gradual refrigerant loss—it's slow enough that you often don't notice until it stops working on the hottest day of the year.",
      },
    ]}
  />

  <!-- Call to Action -->
  <CallToAction
    title="Book Your A/C Service"
    subtitle="Don't wait until you're sweating in traffic. Get your A/C checked before the summer rush."
    actions={[
      { variant: 'primary', text: 'Book A/C Service', href: 'https://sylvanlakeautopro.autotext.me/Admin/kioskv2/index.php?id=WTNHaFJhb1g1dk9YV3g1YmpkUEx3QT09&kiosk=1', target: '_blank' },
      { variant: 'secondary', text: 'Call (403) 887-0440', href: 'tel:+14038870440', class: 'md:hidden' },
      { variant: 'secondary', text: 'Get Directions', href: 'https://www.google.com/maps/dir/?api=1&destination=NAPA+AUTOPRO+-+Sylvan+Lake+AUTOPRO+Inc&destination_place_id=ChIJM5AeqqSydVMRS6-I0MZs35U', class: 'hidden md:inline-flex' },
    ]}
  />
</Layout>
